{
  "name": "justphoenix/laravel-nbs-exchange-rates",
  "description": "Laravel integration for justphoenix/nbs-exchange-rates",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.1",
    "illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0",
    "justphoenix/nbs-exchange-rates": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "JustPhoenix\\LaravelNbsExchangeRates\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "JustPhoenix\\LaravelNbsExchangeRates\\ServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
